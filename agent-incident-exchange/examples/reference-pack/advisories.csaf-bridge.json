          "url": "https://www.cisa.gov/resources-tools/resources/jcdc-ai-cybersecurity-collaboration-playbook"
        }
      ]
    },
    {
      "title": "AAU-AGENT-2026-0003",
      "notes": [
        {
          "category": "summary",
          "text": "A parent stop appears successful while child authority, queued work, independent monitoring, evidence preservation, or the human-gated recovery path remains active or unresolved.",
          "title": "Incomplete delegated-agent containment"
        },
        {
          "category": "general",
          "text": "Containment must stop the parent, revoke delegated authority, cancel queued work, preserve evidence, and keep recovery under an accountable human role.",
          "title": "Authority boundary"
        }
      ],
