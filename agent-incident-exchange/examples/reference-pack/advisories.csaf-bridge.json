        }
      ]
    },
    {
      "title": "AAU-AGENT-2026-0002",
      "notes": [
        {
          "category": "summary",
          "text": "A synthetic dependency upgrade appears to close a vulnerability while legitimate behavior, service continuity, rollback readiness, or human-approved change evidence can remain unproved.",
          "title": "AI-generated dependency upgrade without complete fix evidence"
        },
        {
          "category": "general",
          "text": "The agent may prepare and test the change; an accountable human owns change approval, deployment, continuity risk, and rollback.",
          "title": "Authority boundary"
        }
      ],
      "product_status": {
        "fixed": [
          "generic:ai-generated-dependency-change:synthetic-before",
          "generic:ai-generated-dependency-change:synthetic-after"
        ]
      },
