{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/essential-service-campaign.schema.json",
  "title": "AAU essential-service defense campaign 0.1",
  "type": "object",
  "required": ["campaign_version", "campaign_id", "title", "sector", "as_of", "official_sources", "assets", "vulnerabilities", "continuity_tests", "decisions", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "campaign_version": {"const": "aau-essential-service-campaign/0.1"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "sector": {"type": "string", "minLength": 1, "maxLength": 160},
    "as_of": {"type": "string", "format": "date"},
    "official_sources": {"type": "array", "minItems": 1},
    "assets": {"type": "array", "minItems": 1, "maxItems": 500},
    "vulnerabilities": {"type": "array", "minItems": 1, "maxItems": 500},
    "continuity_tests": {"type": "array", "minItems": 1},
    "decisions": {"type": "array", "minItems": 1},
    "boundaries": {"type": "object"}
  }
}
