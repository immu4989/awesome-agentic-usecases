{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/public-defense-outcomes-report.schema.json",
  "title": "AAU public defense outcomes report 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "mesh_id", "index_sha256", "summary", "visible_gaps", "claim_boundary", "report_sha256"],
  "properties": {
    "report_version": {"const": "aau-public-defense-outcomes-report/0.2"},
    "mesh_id": {"type": "string", "minLength": 1},
    "index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {"type": "object"},
    "visible_gaps": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "object"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
