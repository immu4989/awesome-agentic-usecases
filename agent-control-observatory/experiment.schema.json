{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-control-experiment-0.1.json",
  "title": "AAU Agent Control Experiment 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_version", "experiment_id", "title", "controls", "arms", "cases", "sources", "boundary"],
  "properties": {
    "experiment_version": {"const": "aau-agent-control-experiment/0.1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "arms": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "cases": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "boundary": {"type": "object"}
  }
}
