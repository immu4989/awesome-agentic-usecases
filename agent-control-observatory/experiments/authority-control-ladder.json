    {"arm_id": "identity-only", "title": "Identity and token checks without task or recovery controls", "active_controls": ["agent-identity", "token-binding"], "limitations": ["Identity checks cannot determine whether an otherwise authenticated action remains inside the human task grant."]},
    {"arm_id": "abp-runtime-reference", "title": "ABP 0.2 reference control set", "active_controls": ["task-scope", "agent-identity", "token-binding", "delegation-ceiling", "safe-stop", "external-monitor", "revocation", "record-integrity"], "limitations": ["Reference outcomes are deterministic policy decisions over synthetic cases, not observations of a production enforcement stack."]}
  ],
  "cases": [
