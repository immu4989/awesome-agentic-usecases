{
  "experiment_version": "aau-agent-control-experiment/0.1",
  "experiment_id": "authority-control-ladder-v1",
  "title": "Matched authority controls: prevention without deny-all",
  "controls": [
    {"control_id": "task-scope", "title": "Task, tool, resource, and destination scope", "reason_codes": ["ACTION_OUT_OF_SCOPE", "EGRESS_NOT_ALLOWED"]},
    {"control_id": "agent-identity", "title": "Agent, task, and lease identity binding", "reason_codes": ["IDENTITY_MISMATCH", "AUTHORITY_REF_INVALID"]},
    {"control_id": "token-binding", "title": "Token audience binding and no passthrough", "reason_codes": ["TOKEN_AUDIENCE_MISMATCH", "TOKEN_PASSTHROUGH_FORBIDDEN"]},
    {"control_id": "delegation-ceiling", "title": "Peer and child authority cannot exceed the parent lease", "reason_codes": ["DELEGATION_SCOPE_EXPANSION", "UNAUTHORIZED_PEER"]},
    {"control_id": "safe-stop", "title": "Impossible and broken tasks stop safely", "reason_codes": ["SAFE_STOP_REQUIRED"]},
    {"control_id": "external-monitor", "title": "Monitor loss and critical alerts pause the run", "reason_codes": ["MONITORING_LOST", "CRITICAL_ALERT_PAUSE"]},
    {"control_id": "revocation", "title": "Revocation advances the policy epoch and remains sticky", "reason_codes": ["LEASE_REVOKED", "RUN_REVOKED"]},
    {"control_id": "record-integrity", "title": "Evidence mutation pauses activity", "reason_codes": ["AUDIT_TAMPERING"]}
  ],
  "arms": [
