{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-boundary-runtime-receipt-0.2.json",
  "title": "AAU Agent Boundary Runtime Receipt 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "suite_id", "profile_id", "profile_sha256", "suite_sha256", "run_count", "event_count", "summary", "runs", "chain_head_sha256", "boundary"],
  "properties": {
    "receipt_version": {"const": "aau-agent-boundary-runtime-receipt/0.2"},
    "suite_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_count": {"type": "integer", "minimum": 1},
    "event_count": {"type": "integer", "minimum": 1},
    "summary": {"type": "object"},
    "runs": {"type": "array", "minItems": 1},
    "chain_head_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundary": {"type": "object"}
  }
}
