{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-boundary-runtime-suite-0.2.json",
  "title": "AAU Agent Boundary Runtime Suite 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_id", "title", "boundary", "runs"],
  "properties": {
    "suite_version": {"const": "aau-agent-boundary-runtime-suite/0.2"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only", "no_live_targets", "no_real_credentials", "not_certification"],
      "properties": {
        "synthetic_only": {"const": true},
        "no_live_targets": {"const": true},
        "no_real_credentials": {"const": true},
        "not_certification": {"const": true}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "title", "events"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["expected"],
              "oneOf": [
                {"required": ["event"], "not": {"required": ["envelope"]}},
                {"required": ["adapter", "envelope"], "not": {"required": ["event"]}}
              ],
              "properties": {
                "adapter": {"enum": ["generic", "mcp", "openai-agents", "langgraph", "crewai", "autogen"]},
                "event": {"type": "object"},
                "envelope": {"type": "object"},
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["outcome", "reason_codes", "status_after"],
                  "properties": {
                    "outcome": {"enum": ["allow", "block", "pause", "safe_stop"]},
                    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "status_after": {"enum": ["active", "paused", "safe_stopped", "revoked"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
