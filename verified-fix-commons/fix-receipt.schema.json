{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/verified-fix-receipt-0.1.json",
  "title": "AAU Verified Fix Receipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "fix_id", "contract_sha256", "producer", "run_id", "tested_on", "evidence_level", "summary", "cases", "final_result_sha256", "claim_boundary", "receipt_sha256"],
  "properties": {
    "receipt_version": {"const": "aau-verified-fix-receipt/0.1"},
    "fix_id": {"type": "string"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {"type": "string"},
    "run_id": {"type": "string"},
    "tested_on": {"type": "string", "format": "date"},
    "evidence_level": {"enum": ["designed", "reference_exact"]},
    "summary": {"type": "object"},
    "cases": {"type": "array", "minItems": 1},
    "final_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claim_boundary": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
