{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/verified-fix-contract-0.1.json",
  "title": "AAU Verified Fix Contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "fix_id", "title", "vulnerability", "change", "protected_service", "public_sources", "cases", "evidence", "boundaries"],
  "properties": {
    "contract_version": {"const": "aau-verified-fix-contract/0.1"},
    "fix_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "vulnerability": {"type": "object"},
    "change": {"type": "object"},
    "protected_service": {"type": "object"},
    "public_sources": {"type": "array", "minItems": 1},
    "cases": {"type": "array", "minItems": 4, "maxItems": 100},
    "evidence": {"type": "object"},
    "boundaries": {"type": "object"}
  }
}
