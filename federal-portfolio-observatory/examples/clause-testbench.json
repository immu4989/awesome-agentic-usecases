  "clauses": [
    {
      "clause_id": "data-rights-001",
      "area": "government_data_and_ip",
      "obligation": "The receiving organization can export declared government-provided inputs, outputs, configuration, and evidence in a documented nonproprietary form.",
      "human_owner_role": "Contracting officer with data-rights counsel",
      "tests": [
        "Export declared artifacts",
        "Compare export inventory to the contract data schedule"
      ],
      "required_evidence": [
        "Data schedule",
        "Export manifest",
        "Rights assertion table"
      ],
      "failure_actions": [
        "Keep the obligation open",
        "Route the gap to accountable acquisition and legal review"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "privacy-use-001",
      "area": "privacy_and_training_use",
      "obligation": "Declared agency information is processed only for authorized purposes and is not used for model training without separately documented authority.",
      "human_owner_role": "Senior agency official for privacy",
      "tests": [
        "Inspect configured data-use controls",
        "Exercise deletion and retention evidence",
        "Compare observed transfer endpoints to the declared data flow"
      ],
      "required_evidence": [
        "Authorized-use statement",
        "Data-flow diagram",
        "Retention and deletion receipt"
      ],
      "failure_actions": [
        "Stop the affected data flow",
        "Initiate authorized privacy and security review"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "exit-001",
      "area": "portability_and_exit",
      "obligation": "A clean receiving environment can restore the declared state, reconcile records, revoke access, and complete an operator handoff.",
      "human_owner_role": "Service owner and receiving operator",
      "tests": [
        "Clean-environment restoration rehearsal",
        "State reconciliation",
        "Credential and access revocation",
        "Receiving-operator handoff"
      ],
      "required_evidence": [
        "Export package",
        "Restoration receipt",
        "Reconciliation report",
        "Access-revocation receipt"
      ],
      "failure_actions": [
        "Keep portability status partial",
        "Escalate unresolved exit dependencies"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "price-001",
      "area": "pricing_and_total_cost",
      "obligation": "Usage, infrastructure, integration, oversight, evaluation, accessibility, security, and exit costs remain separately measurable.",
      "human_owner_role": "Program manager and contracting officer",
      "tests": [
        "Recompute a synthetic monthly invoice",
        "Trace usage tiers and pass-through charges",
        "Exercise a declared exit-cost scenario"
      ],
      "required_evidence": [
        "Price schedule",
        "Usage ledger",
        "Total-cost model",
        "Exit-cost schedule"
      ],
      "failure_actions": [
        "Mark total cost unknown",
        "Request accountable price clarification"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "evaluation-001",
      "area": "continuous_evaluation",
      "obligation": "Performance is measured in the intended environment before acceptance and after material model, data, policy, or workflow changes.",
      "human_owner_role": "Program evaluation lead",
      "tests": [
        "Run intended-environment acceptance suite",
        "Trigger material-change regression",
        "Verify stop-threshold notification"
      ],
      "required_evidence": [
        "Versioned evaluation plan",
        "Scenario manifest",
        "Aggregate result receipt",
        "Change log"
      ],
      "failure_actions": [
        "Block the affected acceptance claim",
        "Require remediation and retest"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "accessibility-001",
      "area": "accessibility_and_service_delivery",
      "obligation": "Each declared communication need and staffed recourse channel is tested independently before the affected service path is marked ready.",
      "human_owner_role": "Accessibility program manager and service owner",
      "tests": [
        "Declared-language branch test",
        "Assistive-technology journey test",
        "Staffed escalation rehearsal"
      ],
      "required_evidence": [
        "Accessibility test matrix",
        "Branch-specific receipts",
        "Remediation log"
      ],
      "failure_actions": [
        "Hold the affected service branch",
        "Remediate and retest"
      ],
      "legal_conclusion": false
    },
    {
      "clause_id": "change-notice-001",
      "area": "incident_and_change_notification",
      "obligation": "Material model, data, configuration, security, and service incidents trigger separate dated notices to the declared accountable roles.",
      "human_owner_role": "System owner and incident response lead",
      "tests": [
        "Synthetic model-change notification",
        "Synthetic security incident fan-out",
        "Receipt and follow-up reconciliation"
      ],
      "required_evidence": [
        "Change taxonomy",
        "Recipient graph",
        "Notification receipts",
        "Follow-up record"
      ],
      "failure_actions": [
        "Open the unresolved notification branch",
        "Route the incident to authorized response owners"
      ],
      "legal_conclusion": false
    }
  ]
}
