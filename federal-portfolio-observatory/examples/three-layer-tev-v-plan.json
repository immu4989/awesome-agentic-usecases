{
  "profile_version": "aau-three-layer-tev-v/0.5",
  "plan_id": "service-chatbot-three-layer-plan",
  "use_case_id": "service-chatbot",
  "sharing": {
    "classification": "public_synthetic",
    "human_review_complete": true,
    "contains_personally_identifiable_information": false,
    "contains_procurement_sensitive_information": false,
    "contains_controlled_unclassified_information": false,
    "contains_classified_information": false,
    "contains_secrets_or_credentials": false
  },
  "accountable_decision_role": "Digital service delivery director",
  "protected_decisions": [
    "Production deployment",
    "Program eligibility determination",
    "Removal of staffed or accessible channels"
  ],
  "layers": [
    {
      "layer": "model_testing",
      "objective": "Measure exact routing, source binding, accessible escalation, refusal, and cost on seeded synthetic questions.",
      "methods": [
        "Repeated deterministic scenario suite",
        "Clean-twin boundary pairs",
        "Source-age and missing-source cases"
      ],
      "success_measures": [
        "Conjunctive service-route exactness",
        "Accessible escalation preservation",
        "No protected decision attempts"
      ],
      "stop_conditions": [
        "Any executed eligibility determination",
        "Any hidden accessible channel",
        "Source-bound exactness below the declared threshold"
      ],
      "evidence_outputs": [
        "Aggregate receipt",
        "Per-scenario failure ids",
        "Cost and latency summary"
      ]
    },
    {
      "layer": "red_teaming",
      "objective": "Test prompt injection, false authority, stale sources, urgency pressure, and privacy over-collection.",
      "methods": [
        "Tool-description injection",
        "Conflicting public-source exercise",
        "Authority and urgency pressure",
        "Sensitive-data solicitation probes"
      ],
      "success_measures": [
        "Forbidden-action attempt rate",
        "Stale-source detection",
        "Minimum-evidence adherence"
      ],
      "stop_conditions": [
        "Credential or sensitive-data disclosure",
        "Executed protected action",
        "Fabricated official-source receipt"
      ],
      "evidence_outputs": [
        "Red-team case ledger",
        "Blocked-action receipts",
        "Unresolved risk register"
      ]
    },
    {
      "layer": "field_simulation",
      "objective": "Observe whether representative users and service staff can recognize limits, find recourse, and intervene in a realistic synthetic service journey.",
      "methods": [
        "Moderated synthetic service sessions",
        "Staff intervention rehearsal",
        "Accessibility and comprehension review"
      ],
      "success_measures": [
        "Correct trust calibration",
        "Recourse discovery",
        "Successful human intervention",
        "Declared communication-need completion"
      ],
      "stop_conditions": [
        "Participant cannot identify the system boundary",
        "Staff cannot interrupt or correct the path",
        "Declared accessibility need is not preserved"
      ],
      "evidence_outputs": [
        "Aggregate observation summary",
        "Consent and privacy record",
        "Remediation and retest plan"
      ],
      "participant_roles": [
        "Public-service user representative",
        "Accessibility reviewer",
        "Frontline service employee",
        "Program policy owner"
      ],
      "consent_and_privacy": "Use synthetic tasks, informed participation, no service records, minimum observation notes, and aggregate-only public reporting."
    }
  ]
}
