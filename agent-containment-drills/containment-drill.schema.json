{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/containment-drill.schema.json",
  "title": "AAU agent containment drill 0.1",
  "type": "object",
  "required": ["drill_version", "drill_id", "title", "profile_ref", "control_profile", "runs", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "drill_version": {"const": "aau-agent-containment-drill/0.1"},
    "drill_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "profile_ref": {"type": "string", "minLength": 1, "maxLength": 300},
    "control_profile": {"type": "object"},
    "runs": {"type": "array", "minItems": 2, "maxItems": 50},
    "boundaries": {"type": "object"}
  }
}
