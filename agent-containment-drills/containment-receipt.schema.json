{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/containment-receipt.schema.json",
  "title": "AAU agent containment receipt 0.1",
  "type": "object",
  "required": ["receipt_version", "drill_id", "drill_sha256", "summary", "runs", "final_result_sha256", "claim_boundary", "receipt_sha256"],
  "additionalProperties": false,
  "properties": {
    "receipt_version": {"const": "aau-agent-containment-receipt/0.1"},
    "drill_id": {"type": "string"},
    "drill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {"type": "object"},
    "runs": {"type": "array"},
    "final_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claim_boundary": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
