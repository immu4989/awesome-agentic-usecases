{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/human-baseline-study.schema.json",
  "title": "AAU Human Baseline Study",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_version", "study_id", "suite_id", "suite_sha256", "title", "purpose", "classification", "outcomes", "participant_roles", "cases", "measures", "human_protections", "boundary"],
  "properties": {
    "study_version": {"const": "aau-human-baseline-study/1.0"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "suite_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "classification": {"enum": ["public", "synthetic", "public_synthetic"]},
    "outcomes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "participant_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["domain_operator", "service_reviewer", "generalist_reviewer"]}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "input"],
        "properties": {"scenario_id": {"type": "string", "minLength": 1, "maxLength": 120}, "input": {"type": "object"}}
      }
    },
    "measures": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["outcome_exact_rate", "abstain_rate", "task_time_ms", "confidence_calibration", "inter_rater_agreement"]}},
    "human_protections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutional_determination_required", "review_status", "direct_identifiers_prohibited", "production_data_prohibited", "voluntary_participation_required", "withdrawal_path_required"],
      "properties": {
        "institutional_determination_required": {"const": true},
        "review_status": {"const": "not_determined"},
        "direct_identifiers_prohibited": {"const": true},
        "production_data_prohibited": {"const": true},
        "voluntary_participation_required": {"const": true},
        "withdrawal_path_required": {"const": true}
      }
    },
    "boundary": {"const": "This blinded synthetic protocol supports baseline design and aggregate measurement. It is not an institutional human-subjects determination, IRB approval, production validation, certification, workforce decision, or authority to deploy AI."}
  }
}
