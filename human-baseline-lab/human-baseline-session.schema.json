{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/human-baseline-session.schema.json",
  "title": "AAU Human Baseline Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_version", "study_id", "study_sha256", "anonymous_session_id", "session_kind", "participant_role", "protection_basis", "responses", "boundary"],
  "properties": {
    "session_version": {"const": "aau-human-baseline-session/1.0"},
    "study_id": {"type": "string"},
    "study_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "anonymous_session_id": {"type": "string", "pattern": "^[a-f0-9]{12,64}$"},
    "session_kind": {"enum": ["synthetic_reference", "human_observed"]},
    "participant_role": {"enum": ["domain_operator", "service_reviewer", "generalist_reviewer"]},
    "protection_basis": {"enum": ["synthetic_only", "institutional_determination_recorded", "institutional_review_recorded"]},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "outcome", "confidence", "elapsed_ms"],
        "properties": {
          "scenario_id": {"type": "string"},
          "outcome": {"type": "string"},
          "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
          "elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
        }
      }
    },
    "boundary": {"const": "This session contains one local evaluator's synthetic-task responses. Do not publish participant-level files or use them for employment decisions."}
  },
  "allOf": [
    {
      "if": {"properties": {"session_kind": {"const": "synthetic_reference"}}},
      "then": {"properties": {"protection_basis": {"const": "synthetic_only"}}}
    },
    {
      "if": {"properties": {"session_kind": {"const": "human_observed"}}},
      "then": {"properties": {"protection_basis": {"enum": ["institutional_determination_recorded", "institutional_review_recorded"]}}}
    }
  ]
}
