{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/cyber-defense-evidence-mesh.schema.json",
  "title": "AAU cyber defense evidence mesh contract 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["mesh_version", "mesh_id", "title", "producer", "artifacts", "boundaries"],
  "properties": {
    "mesh_version": {"const": "aau-cyber-defense-evidence-mesh/0.2"},
    "mesh_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "producer": {"type": "string", "minLength": 1, "maxLength": 220},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "evidence_level", "producer", "reproduction_pack_path"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "kind": {"enum": ["verified_fix", "containment_drill", "defender_campaign", "defense_benchmark"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^/].*\\.json$"},
          "evidence_level": {"enum": ["designed", "synthetic_reference", "reference_exact", "independently_reproduced"]},
          "producer": {"type": "string", "minLength": 1, "maxLength": 220},
          "reproduction_pack_path": {"type": ["string", "null"], "minLength": 1, "maxLength": 240}
        },
        "allOf": [
          {
            "if": {"properties": {"evidence_level": {"const": "independently_reproduced"}}},
            "then": {"properties": {"reproduction_pack_path": {"type": "string"}}},
            "else": {"properties": {"reproduction_pack_path": {"type": "null"}}}
          }
        ]
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["public_safe_artifacts_only", "raw_logs_excluded", "personal_data_excluded", "credentials_and_targets_excluded", "aggregate_outcomes_only", "not_a_threat_intelligence_feed", "not_a_certification"],
      "properties": {
        "public_safe_artifacts_only": {"const": true},
        "raw_logs_excluded": {"const": true},
        "personal_data_excluded": {"const": true},
        "credentials_and_targets_excluded": {"const": true},
        "aggregate_outcomes_only": {"const": true},
        "not_a_threat_intelligence_feed": {"const": true},
        "not_a_certification": {"const": true}
      }
    }
  }
}
