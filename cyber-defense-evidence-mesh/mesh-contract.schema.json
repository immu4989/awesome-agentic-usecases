{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/cyber-defense-evidence-mesh.schema.json",
  "title": "AAU cyber defense evidence mesh contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mesh_version", "mesh_id", "title", "producer", "artifacts", "boundaries"],
  "properties": {
    "mesh_version": {"const": "aau-cyber-defense-evidence-mesh/0.1"},
    "mesh_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "producer": {"type": "string", "minLength": 1, "maxLength": 220},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 100},
    "boundaries": {"type": "object"}
  }
}
