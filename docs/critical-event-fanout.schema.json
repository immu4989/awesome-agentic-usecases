{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/critical-event-fanout.schema.json",
  "title": "Awesome Agentic Use Cases Critical Event Fan-Out Graph",
  "description": "A machine-readable critical event whose response, notification, recipient, update, and follow-up branches remain independently true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_id", "rule_snapshot", "event_facts", "branches", "protected_decisions"],
  "properties": {
    "contract_version": {"const": "aau-critical-event-fanout/1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "rule_snapshot": {"type": "string", "minLength": 1},
    "event_facts": {"type": "object", "minProperties": 1},
    "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
    "protected_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "branch": {
      "type": "object", "additionalProperties": false,
      "required": ["branch_id", "branch_type", "rule_id", "trigger_facts", "clock_origin", "deadline", "recipient", "human_owner", "receipt"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "branch_type": {"enum": ["emergency_response", "initial_notification", "recipient_notification", "regulatory_update", "follow_up"]},
        "rule_id": {"type": "string", "minLength": 1},
        "trigger_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "clock_origin": {
          "type": "object", "additionalProperties": false, "required": ["fact", "occurred_at", "source_record"],
          "properties": {
            "fact": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"},
            "source_record": {"type": "string", "minLength": 1}
          }
        },
        "deadline": {
          "type": "object", "additionalProperties": false, "required": ["due_at", "time_semantics", "calculation_basis"],
          "properties": {
            "due_at": {"type": "string", "format": "date-time"},
            "time_semantics": {"enum": ["minutes", "hours", "calendar_days", "business_days", "annual"]},
            "calculation_basis": {"type": "string", "minLength": 1}
          }
        },
        "recipient": {
          "type": "object", "additionalProperties": false, "required": ["organization", "channel"],
          "properties": {"organization": {"type": "string", "minLength": 1}, "channel": {"type": "string", "minLength": 1}}
        },
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "human_owner": {"type": "string", "minLength": 1},
        "receipt": {
          "type": "object", "additionalProperties": false, "required": ["stage"],
          "properties": {
            "stage": {"enum": ["not_started", "prepared", "attempted", "delivered", "accepted", "updated", "closed"]},
            "receipt_id": {"type": ["string", "null"]},
            "occurred_at": {"type": ["string", "null"], "format": "date-time"},
            "source_record": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
