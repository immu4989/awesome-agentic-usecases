{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/rights-continuity.schema.json",
  "title": "Awesome Agentic Use Cases Rights Continuity Graph",
  "description": "A machine-readable service case with independently triggered primary and companion rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "rule_snapshot", "held_evidence", "unresolved_evidence", "rights", "protected_decisions"],
  "properties": {
    "contract_version": {"const": "aau-rights-continuity/1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "rule_snapshot": {"type": "string", "minLength": 1},
    "held_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rights": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/right"}},
    "protected_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "right": {
      "type": "object",
      "additionalProperties": false,
      "required": ["right_id", "kind", "rule_id", "trigger", "deadline", "channel", "recourse", "human_owner", "receipt"],
      "properties": {
        "right_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["primary", "companion"]},
        "rule_id": {"type": "string", "minLength": 1},
        "trigger": {
          "type": "object", "additionalProperties": false,
          "required": ["fact", "occurred_at", "source_record"],
          "properties": {
            "fact": {"type": "string", "minLength": 1},
            "occurred_at": {"type": "string", "format": "date-time"},
            "source_record": {"type": "string", "minLength": 1}
          }
        },
        "deadline": {
          "type": "object", "additionalProperties": false,
          "required": ["due_at", "time_semantics", "calculation_basis"],
          "properties": {
            "due_at": {"type": "string", "format": "date-time"},
            "time_semantics": {"enum": ["hours", "calendar_days", "business_days", "months", "state_specific"]},
            "calculation_basis": {"type": "string", "minLength": 1}
          }
        },
        "channel": {"type": "string", "minLength": 1},
        "recourse": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "human_owner": {"type": "string", "minLength": 1},
        "receipt": {
          "type": "object", "additionalProperties": false, "required": ["stage"],
          "properties": {
            "stage": {"enum": ["not_started", "prepared", "submitted", "received", "under_review", "decided", "benefit_active"]},
            "receipt_id": {"type": ["string", "null"]},
            "occurred_at": {"type": ["string", "null"], "format": "date-time"},
            "source_record": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
