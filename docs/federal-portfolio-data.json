          "area": "government_data_and_ip",
          "obligation": "The receiving organization can export declared government-provided inputs, outputs, configuration, and evidence in a documented nonproprietary form.",
          "human_owner_role": "Contracting officer with data-rights counsel",
          "tests": [
            "Export declared artifacts",
            "Compare export inventory to the contract data schedule"
