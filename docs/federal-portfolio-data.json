          "required_evidence": [
            "Authorized-use statement",
            "Data-flow diagram",
            "Retention and deletion receipt"
          ],
          "failure_actions": [
            "Stop the affected data flow",
            "Initiate authorized privacy and security review"
          ],
          "legal_conclusion": false
        },
        {
          "clause_id": "exit-001",
          "area": "portability_and_exit",
          "obligation": "A clean receiving environment can restore the declared state, reconcile records, revoke access, and complete an operator handoff.",
          "human_owner_role": "Service owner and receiving operator",
          "tests": [
            "Clean-environment restoration rehearsal",
            "State reconciliation",
            "Credential and access revocation",
            "Receiving-operator handoff"
          ],
          "required_evidence": [
            "Export package",
            "Restoration receipt",
            "Reconciliation report",
            "Access-revocation receipt"
          ],
          "failure_actions": [
            "Keep portability status partial",
            "Escalate unresolved exit dependencies"
          ],
          "legal_conclusion": false
        },
        {
