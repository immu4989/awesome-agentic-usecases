          "required_evidence": [
            "Data schedule",
            "Export manifest",
            "Rights assertion table"
          ],
          "failure_actions": [
            "Keep the obligation open",
            "Route the gap to accountable acquisition and legal review"
          ],
          "legal_conclusion": false
        },
        {
          "clause_id": "privacy-use-001",
          "area": "privacy_and_training_use",
          "obligation": "Declared agency information is processed only for authorized purposes and is not used for model training without separately documented authority.",
          "human_owner_role": "Senior agency official for privacy",
          "tests": [
            "Inspect configured data-use controls",
            "Exercise deletion and retention evidence",
