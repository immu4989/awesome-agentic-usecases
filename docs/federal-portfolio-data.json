            "Total-cost model",
            "Exit-cost schedule"
          ],
          "failure_actions": [
            "Mark total cost unknown",
            "Request accountable price clarification"
          ],
          "legal_conclusion": false
        },
        {
          "clause_id": "evaluation-001",
          "area": "continuous_evaluation",
          "obligation": "Performance is measured in the intended environment before acceptance and after material model, data, policy, or workflow changes.",
          "human_owner_role": "Program evaluation lead",
          "tests": [
