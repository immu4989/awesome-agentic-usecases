{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/awesome-agentic-usecases/public-value-contract.schema.json",
  "title": "Public Value Contract",
  "description": "Machine-checkable obligations for an agent-mediated service interaction.",
  "type": "object",
  "required": [
    "version",
    "expected_terminal",
    "required_evidence",
    "held_evidence",
    "required_channel",
    "recourse_required",
    "deadline_preservation_required",
    "forbidden_events"
  ],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "expected_terminal": {"type": "string", "minLength": 1},
    "required_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "held_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_channel": {"type": "string", "minLength": 1},
    "recourse_required": {"type": "boolean"},
    "deadline_preservation_required": {"type": "boolean"},
    "forbidden_events": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
