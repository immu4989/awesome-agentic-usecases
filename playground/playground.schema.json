{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/awesome-agentic-usecases/blob/main/playground/playground.schema.json",
  "title": "AAU interactive evidence playground",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "description", "scenarios"],
  "properties": {
    "schema_version": {"const": "aau-playground/1.0"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "order", "title", "industry", "failure_shape", "stake", "lesson",
          "verdict", "lab_path", "scenario_id", "result_path", "repeat", "challenge_id"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "industry": {"type": "string", "minLength": 1},
          "failure_shape": {"type": "string", "minLength": 1},
          "stake": {"type": "string", "minLength": 1},
          "lesson": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["trust", "verify", "block"]},
          "adapter": {"enum": ["decision_gate", "security_exfil"], "default": "decision_gate"},
          "lab_path": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
          "scenario_id": {"type": "string", "minLength": 1},
          "result_path": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/results/eval_.+\\.json$"},
          "repeat": {"type": "integer", "minimum": 0},
          "challenge_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
