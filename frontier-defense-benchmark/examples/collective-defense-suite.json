    {"source_id": "nist-agent-identity", "publisher": "NIST NCCoE", "title": "Software and AI Agent Identity and Authorization", "url": "https://www.nccoe.nist.gov/projects/software-and-ai-agent-identity-and-authorization"},
    {"source_id": "otel-genai", "publisher": "OpenTelemetry", "title": "GenAI semantic conventions", "url": "https://github.com/open-telemetry/semantic-conventions-genai"}
