    "system_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "adapter_description": {"type": "string", "minLength": 1, "maxLength": 400},
    "responses": {"type": "array", "minItems": 1},
    "boundaries": {"type": "object"}
  }
}
