{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/frontier-defense-responses.schema.json",
  "title": "AAU frontier defensive capability responses 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_version", "suite_id", "system_id", "adapter_description", "responses", "boundaries"],
  "properties": {
    "response_version": {"const": "aau-frontier-defense-responses/0.1"},
