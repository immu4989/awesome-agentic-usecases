{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/frontier-defense-benchmark.schema.json",
  "title": "AAU frontier defensive capability benchmark 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_id", "title", "official_sources", "tasks", "boundaries"],
  "properties": {
    "suite_version": {"const": "aau-frontier-defense-benchmark/0.1"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "official_sources": {"type": "array", "minItems": 1},
    "tasks": {"type": "array", "minItems": 10, "maxItems": 200},
    "boundaries": {"type": "object"}
  }
}
