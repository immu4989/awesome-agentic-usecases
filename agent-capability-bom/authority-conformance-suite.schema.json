{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/authority-conformance-suite-1.1.json",
  "title": "AAU Agent Authority Conformance Suite 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_id", "agent_id", "release_id", "bom_sha256", "generated_at", "cases", "boundary"],
  "properties": {
    "suite_version": { "const": "aau-agent-authority-conformance-suite/1.1" },
    "suite_id": { "$ref": "#/$defs/text" },
    "agent_id": { "$ref": "#/$defs/text" },
    "release_id": { "$ref": "#/$defs/text" },
    "bom_sha256": { "$ref": "#/$defs/sha256" },
    "generated_at": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/case" }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_contain_no_credentials_or_payloads", "adapter_cannot_execute_tools", "reference_result_not_product_or_deployment_evidence", "passing_not_certification_compliance_or_authorization"],
      "properties": {
        "requests_contain_no_credentials_or_payloads": { "const": true },
        "adapter_cannot_execute_tools": { "const": true },
        "reference_result_not_product_or_deployment_evidence": { "const": true },
        "passing_not_certification_compliance_or_authorization": { "const": true }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reasonCodes": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "tool_id", "operation", "resource_scope", "evaluated_at", "revoked", "delegation_depth", "human_approval_present"],
      "properties": {
        "authority_id": { "$ref": "#/$defs/text" },
        "tool_id": { "$ref": "#/$defs/text" },
        "operation": { "$ref": "#/$defs/text" },
        "resource_scope": { "$ref": "#/$defs/text" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "delegation_depth": { "type": "integer", "minimum": 0 },
        "human_approval_present": { "type": "boolean" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "shape", "input", "expected_decision", "expected_reason_codes", "clean_twin"],
      "properties": {
        "case_id": { "$ref": "#/$defs/text" },
        "shape": { "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/input" },
        "expected_decision": { "enum": ["allow", "block"] },
        "expected_reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "clean_twin": { "type": "boolean" }
      }
    }
  }
}
