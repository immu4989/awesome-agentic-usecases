{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-incident-regression-0.1.json",
  "title": "AAU Agent Incident Regression Record 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_version", "incident_id", "title", "published_at", "public_sources", "classification", "failure", "timeline", "regressions", "recovery", "limitations", "claims"],
  "properties": {
    "incident_version": {"const": "aau-agent-incident-regression/0.1"},
    "incident_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date"},
    "public_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "classification": {
      "type": "object",
      "required": ["mode", "contains_real_credentials", "contains_personal_data", "contains_nonpublic_telemetry", "contains_exploit_instructions", "contains_live_targets"],
      "properties": {
        "mode": {"const": "public_synthetic_abstraction"},
        "contains_real_credentials": {"const": false},
        "contains_personal_data": {"const": false},
        "contains_nonpublic_telemetry": {"const": false},
        "contains_exploit_instructions": {"const": false},
        "contains_live_targets": {"const": false}
      }
    },
    "failure": {"type": "object"},
    "timeline": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "regressions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}},
    "recovery": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claims": {"type": "object"}
  }
}
