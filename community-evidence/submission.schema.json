{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/community-evidence/submission.schema.json",
  "title": "AAU Community Evidence Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "origin", "contributor", "summary", "why_fork",
    "beneficiaries", "industry", "failure_shape", "tags", "review", "reproduction",
    "package_version", "starter_version", "suite_id", "suite_sha256", "receipt_files"
  ],
  "properties": {
    "schema_version": {"const": "aau-community-evidence/1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "origin": {"enum": ["community-submission", "maintainer-reference"]},
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "github"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "why_fork": {"type": "string", "minLength": 1, "maxLength": 240},
    "beneficiaries": {"type": "string", "minLength": 1, "maxLength": 240},
    "industry": {"type": "string", "minLength": 1, "maxLength": 240},
    "failure_shape": {"type": "string", "minLength": 1, "maxLength": 240},
    "tags": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
    "review": {"type": "object"},
    "reproduction": {"type": "object"},
    "package_version": {"type": "string"},
    "starter_version": {"const": "aau-agent-evidence-starter/1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_files": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "pattern": "^receipts/run-[0-9]{2}\\.json$"}}
  }
}
