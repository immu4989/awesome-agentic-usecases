{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-side-effect-receipt-0.2.json",
  "title": "AAU Agent Side-Effect Receipt 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "suite_id", "suite_sha256", "summary", "cases", "final_result_sha256", "claim_boundary", "receipt_sha256"],
  "properties": {
    "receipt_version": {"const": "aau-agent-side-effect-receipt/0.2"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "required": ["case_count", "event_count", "exact_outcome_rate", "exact_reason_rate", "known_primary_effect_count", "compensation_effect_count", "unresolved_effect_count", "duplicate_effects_prevented", "key_conflicts_blocked", "unknown_retries_blocked", "reconciliation_count", "at_most_one_breach_count"]
    },
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "final_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_boundary": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
