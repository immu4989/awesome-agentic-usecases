{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-side-effect-race-receipt-0.1.json",
  "title": "AAU Agent Side-Effect Race Receipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "adapter_protocol_version", "suite_id", "suite_sha256", "adapter_kind", "status", "summary", "results", "final_result_sha256", "claim_boundary", "receipt_sha256"],
  "properties": {
    "receipt_version": {"const": "aau-agent-side-effect-race-receipt/0.1"},
    "adapter_protocol_version": {"const": "aau-agent-side-effect-race-adapter/0.1"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "suite_sha256": {"$ref": "#/$defs/digest"},
    "adapter_kind": {"const": "multi_process_command"},
    "status": {"enum": ["evidence_passed", "evidence_failed"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "attempt_count", "exact_count", "exact_rate", "duplicate_effect_count", "missing_effect_count", "response_state_mismatch_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "attempt_count": {"type": "integer", "minimum": 1},
        "exact_count": {"type": "integer", "minimum": 0},
        "exact_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "duplicate_effect_count": {"type": "integer", "minimum": 0},
        "missing_effect_count": {"type": "integer", "minimum": 0},
        "response_state_mismatch_count": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "attempt_count", "actual", "response_groups", "exact", "previous_result_sha256", "result_sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "attempt_count": {"type": "integer", "minimum": 2},
          "actual": {"$ref": "#/$defs/aggregate"},
          "response_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "reason_codes", "count"],
              "properties": {
                "outcome": {"enum": ["committed", "replayed", "conflict", "blocked"]},
                "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
                "count": {"type": "integer", "minimum": 1}
              }
            }
          },
          "exact": {"type": "boolean"},
          "previous_result_sha256": {"$ref": "#/$defs/digest"},
          "result_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "final_result_sha256": {"$ref": "#/$defs/digest"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_withheld_from_adapter", "post_race_state_inspected", "public_synthetic_state_only", "concurrent_launch_not_scheduler_overlap_proof", "adapter_command_is_trusted_local_code", "passing_not_linearizability_exactly_once_or_production_evidence"],
      "properties": {
        "oracle_withheld_from_adapter": {"const": true},
        "post_race_state_inspected": {"const": true},
        "public_synthetic_state_only": {"const": true},
        "concurrent_launch_not_scheduler_overlap_proof": {"const": true},
        "adapter_command_is_trusted_local_code": {"const": true},
        "passing_not_linearizability_exactly_once_or_production_evidence": {"const": true}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_count", "key_count", "committed_count", "replayed_count", "conflict_count", "blocked_count"],
      "properties": {
        "effect_count": {"type": "integer", "minimum": 0},
        "key_count": {"type": "integer", "minimum": 0},
        "committed_count": {"type": "integer", "minimum": 0},
        "replayed_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
