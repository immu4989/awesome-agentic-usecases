{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-side-effect-safety-matrix-0.4.json",
  "title": "AAU Agent Side-Effect Safety Matrix 0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_version", "status", "component_count", "components", "aggregate", "coverage_binding", "adapter_artifacts", "claim_boundary", "matrix_sha256"],
  "properties": {
    "matrix_version": {"const": "aau-agent-side-effect-safety-matrix/0.4"},
    "status": {"enum": ["evidence_passed", "evidence_failed"]},
    "component_count": {"const": 3},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "status", "suite_sha256", "receipt_sha256", "case_count", "checked_outcome_count", "exact_count", "unsafe_count", "availability_loss_count", "unresolved_count"],
        "properties": {
          "component_id": {"enum": ["semantics", "crash_recovery", "concurrency"]},
          "status": {"enum": ["evidence_passed", "evidence_failed"]},
          "suite_sha256": {"$ref": "#/$defs/digest"},
          "receipt_sha256": {"$ref": "#/$defs/digest"},
          "case_count": {"type": "integer", "minimum": 1},
          "checked_outcome_count": {"type": "integer", "minimum": 1},
          "exact_count": {"type": "integer", "minimum": 0},
          "unsafe_count": {"type": "integer", "minimum": 0},
          "availability_loss_count": {"type": "integer", "minimum": 0},
          "unresolved_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "checked_outcome_count", "exact_count", "unsafe_count", "availability_loss_count", "unresolved_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "checked_outcome_count": {"type": "integer", "minimum": 1},
        "exact_count": {"type": "integer", "minimum": 0},
        "unsafe_count": {"type": "integer", "minimum": 0},
        "availability_loss_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0}
      }
    },
    "coverage_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "operation", "semantic_boundary_present", "crash_race_same_boundary", "semantic_tool_operation_count", "fully_stressed_tool_operation_count"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "operation": {"type": "string", "minLength": 1, "maxLength": 160},
        "semantic_boundary_present": {"const": true},
        "crash_race_same_boundary": {"const": true},
        "semantic_tool_operation_count": {"type": "integer", "minimum": 1},
        "fully_stressed_tool_operation_count": {"const": 1}
      }
    },
    "adapter_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "source_path", "pack_path", "command_argv_index", "launch_mode", "size_bytes", "sha256", "materials_pack_path", "material_capture_mode", "material_count", "unresolved_import_count", "material_set_sha256"],
        "properties": {
          "component_id": {"enum": ["semantics", "crash_recovery", "concurrency"]},
          "source_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "pack_path": {"enum": ["semantic-adapter.artifact", "crash-adapter.artifact", "race-adapter.artifact"]},
          "command_argv_index": {"type": "integer", "enum": [0, 1]},
          "launch_mode": {"enum": ["direct_executable", "supported_interpreter_target"]},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
          "sha256": {"$ref": "#/$defs/digest"},
          "materials_pack_path": {"enum": ["semantic-adapter.materials.json", "crash-adapter.materials.json", "race-adapter.materials.json"]},
          "material_capture_mode": {"enum": ["static_local_python_imports", "entrypoint_only_non_python"]},
          "material_count": {"type": "integer", "minimum": 1, "maximum": 200},
          "unresolved_import_count": {"type": "integer", "minimum": 0, "maximum": 200},
          "material_set_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_adapter_requests_withhold_expected_answers", "component_metrics_remain_separate", "unresolved_can_be_correct_safe_behavior", "commands_are_trusted_local_code", "public_synthetic_staging_only", "crash_and_race_bind_one_semantic_tool_operation", "matrix_does_not_imply_every_semantic_tool_has_crash_race_coverage", "command_argument_references_declared_artifact", "declared_artifact_is_executable_or_supported_interpreter_target", "declared_artifact_path_normalized_before_execution", "adapter_artifact_same_before_and_after_matrix_run", "captured_materials_same_before_and_after_matrix_run", "command_text_not_recorded", "static_local_python_import_materials_captured", "unresolved_imports_remain_explicit", "not_interpreter_installed_dependency_config_environment_container_or_runtime_identity", "passing_not_atomicity_linearizability_exactly_once_or_deployment_authority"],
      "properties": {
        "all_adapter_requests_withhold_expected_answers": {"const": true},
        "component_metrics_remain_separate": {"const": true},
        "unresolved_can_be_correct_safe_behavior": {"const": true},
        "commands_are_trusted_local_code": {"const": true},
        "public_synthetic_staging_only": {"const": true},
        "crash_and_race_bind_one_semantic_tool_operation": {"const": true},
        "matrix_does_not_imply_every_semantic_tool_has_crash_race_coverage": {"const": true},
        "command_argument_references_declared_artifact": {"const": true},
        "declared_artifact_is_executable_or_supported_interpreter_target": {"const": true},
        "declared_artifact_path_normalized_before_execution": {"const": true},
        "adapter_artifact_same_before_and_after_matrix_run": {"const": true},
        "captured_materials_same_before_and_after_matrix_run": {"const": true},
        "command_text_not_recorded": {"const": true},
        "static_local_python_import_materials_captured": {"const": true},
        "unresolved_imports_remain_explicit": {"const": true},
        "not_interpreter_installed_dependency_config_environment_container_or_runtime_identity": {"const": true},
        "passing_not_atomicity_linearizability_exactly_once_or_deployment_authority": {"const": true}
      }
    },
    "matrix_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
