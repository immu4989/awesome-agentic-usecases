{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immu4989.github.io/awesome-agentic-usecases/schemas/agent-side-effect-release-binding-plan-0.1.json",
  "title": "AAU Agent Side-Effect Release Binding Plan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_version", "binding_id", "agent_id", "release_id", "bindings", "boundaries"],
  "properties": {
    "binding_version": {"const": "aau-agent-side-effect-release-binding-plan/0.1"},
    "binding_id": {"$ref": "#/$defs/text160"},
    "agent_id": {"$ref": "#/$defs/text160"},
    "release_id": {"$ref": "#/$defs/text160"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "operation", "semantic_adapter", "crash_adapter", "race_adapter"],
        "properties": {
          "tool_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "operation": {"$ref": "#/$defs/text160"},
          "semantic_adapter": {"$ref": "#/$defs/relativePath"},
          "crash_adapter": {"$ref": "#/$defs/relativePath"},
          "race_adapter": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_synthetic_staging_only", "adapter_paths_workspace_relative", "all_consequential_operations_must_be_bound", "human_approval_required_for_consequential_authority", "no_production_identity_or_deployment_claim"],
      "properties": {
        "public_synthetic_staging_only": {"const": true},
        "adapter_paths_workspace_relative": {"const": true},
        "all_consequential_operations_must_be_bound": {"const": true},
        "human_approval_required_for_consequential_authority": {"const": true},
        "no_production_identity_or_deployment_claim": {"const": true}
      }
    }
  },
  "$defs": {
    "text160": {"type": "string", "minLength": 1, "maxLength": 160},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
